root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Notes and corpus cases. No Tern construct depends on trailing whitespace,
# but the bodies of fences, raw HTML and display math are kept byte for
# byte, so an editor must not strip whitespace inside them. Leave these files
# alone rather than guess where the verbatim bodies are.
[*.{html,txt}]
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false
